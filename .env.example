# 复制为 .env 后填写；.env 已被 .gitignore 忽略，切勿提交
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 评分模型：deepseek-flash（性价比）/ deepseek-v4-pro（更强推理，约 4~5 倍价格）
DEEPSEEK_MODEL=deepseek-flash
# 思考模式强度：low / high / max（思考模式下 temperature 不生效）
DEEPSEEK_REASONING_EFFORT=high

# 每题重复采样次数，用于聚合与置信度估计
GRADING_SAMPLES=3
# 并发上限，需小于账号并发限制
GRADING_CONCURRENCY=8

DATABASE_URL=sqlite:///./data/deepjudge.db
