# 复制为 .env 后填写；.env 已被 .gitignore 忽略，切勿提交
#
# LLM API：供应商、模型与参数待补充。变量名先按 DeepSeek 预留，
# 接入时以实际 SDK 文档为准，并同步更新 backend 中 providers 的读取逻辑。

DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型名接入时填写
DEEPSEEK_MODEL=

# 每题重复采样次数，用于聚合与置信度估计
GRADING_SAMPLES=3
# 并发上限，需小于账号并发限制
GRADING_CONCURRENCY=8

# 开发期用 SQLite；数据库选型确定后再改
DATABASE_URL=sqlite:///./data/deepjudge.db
