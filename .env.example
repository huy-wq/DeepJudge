# 复制为 .env 后填写；.env 已被 .gitignore 忽略，切勿提交

DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 默认 deepseek-flash；对照实验可换 deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-flash
# 可选：请求超时（秒）与单次输出上限
DEEPSEEK_TIMEOUT=120
DEEPSEEK_MAX_TOKENS=2048
# 思考强度：low / high / max；设为空字符串则不发送
DEEPSEEK_REASONING_EFFORT=high

# 每题重复采样次数，用于聚合与置信度估计
GRADING_SAMPLES=3
# 并发上限，需小于账号并发限制
GRADING_CONCURRENCY=8

# 数据库：./scripts/dev-db.sh up 起的本地 MySQL 8 映射在 3307（避开本机可能占用的 3306）
# 字符集必须写 charset=utf8mb4，否则中文与 emoji 会在连接层被截成 utf8mb3
DATABASE_URL=mysql+pymysql://deepjudge:deepjudge@127.0.0.1:3307/deepjudge?charset=utf8mb4
