# 复制为 .env 后填写；.env 已被 .gitignore 忽略，切勿提交

DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 默认 deepseek-flash；对照实验可换 deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-flash
# 可选：请求超时（秒）与单次输出上限
DEEPSEEK_TIMEOUT=120
DEEPSEEK_MAX_TOKENS=2048
# 思考强度：low / high / max；设为空字符串则不发送
DEEPSEEK_REASONING_EFFORT=high

# 生成评分标准用的模型（强档）。留空则退回 DEEPSEEK_MODEL。
# 生成只跑一次、评分要跑 N×M 次，所以两者应当分开配置（架构 §5.2）。
DEEPSEEK_GEN_MODEL=

# 每题重复采样次数，用于聚合与置信度估计
GRADING_SAMPLES=3
# 并发上限，需小于账号并发限制
GRADING_CONCURRENCY=8

# 管理端口令：唯一凭据，不分账号。留空则服务启动即失败（不会静默放行）。
ADMIN_PASSWORD=
# 会话有效期（小时）
ADMIN_SESSION_HOURS=8
# 只在 HTTPS 后面设为 true；本地 http 演示必须留 false，否则 cookie 发不下来
COOKIE_SECURE=false

# 数据库：./scripts/dev-db.sh up 起的本地 MySQL 8 映射在 3307（避开本机可能占用的 3306）
# 字符集必须写 charset=utf8mb4，否则中文与 emoji 会在连接层被截成 utf8mb3
DATABASE_URL=mysql+pymysql://deepjudge:deepjudge@127.0.0.1:3307/deepjudge?charset=utf8mb4
